<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <property name="version" value="6.0" />
  
  <!-- Input assemblies -->
  <input>
    <asmlist>
      <inputassembly>
        <option>createpdb</option>
        <option>stripoa</option>
        <file dir="${configdir}\bin\Release" name="Counselor.exe" />
      </inputassembly>
    </asmlist>
  </input>

  <!-- Output directory -->
  <output dir="${configdir}\bin\Release\Obfuscated" />

  <!-- Renaming (Obfuscation) Settings -->
  <rename>
    <!-- Enable enhanced overload induction for better obfuscation -->
    <option>enhancedOI</option>
    <!-- Use unprintable characters for maximum obfuscation -->
    <option>unprintable</option>
    
    <!-- Exclude items that must remain public for WinForms functionality -->
    <exclusionlist>
      <!-- Keep entry point -->
      <method regex="false" type="CounselQuickPlatinum.Program" name="Main" signature="(string[])" />
      
      <!-- Keep Windows Forms event handlers and properties -->
      <namespace regex="true" name="CounselQuickPlatinum\.Properties.*" />
      <type regex="true" name=".*\.Designer" />
      <type regex="true" name=".*\.Resources" />
      <type regex="true" name=".*\.Settings" />
      
      <!-- Keep public types that may be accessed via reflection -->
      <type regex="false" name="CounselQuickPlatinum.Form1" />
      
      <!-- Keep any types marked with specific attributes -->
      <attributelist>
        <type name="System.Reflection.ObfuscationAttribute" />
        <type name="System.ComponentModel.DesignerCategoryAttribute" />
      </attributelist>
      
      <!-- Keep serializable types structure -->
      <type regex="true" name=".*Exception" />
      <type regex="true" name=".*EventArgs" />
    </exclusionlist>
    
    <!-- Mapping file for debugging obfuscated code -->
    <mapfile>
      <file dir="${configdir}\bin\Release" name="Counselor_map.xml" />
    </mapfile>
  </rename>

  <!-- Control Flow Obfuscation -->
  <controlflow>
    <!-- Apply control flow obfuscation to all methods except excluded ones -->
    <exclusionlist>
      <!-- Exclude constructors and event handlers from control flow obfuscation -->
      <method regex="true" name="\.ctor" />
      <method regex="true" name=".*_.*" signature=".*EventArgs.*" />
      
      <!-- Exclude Properties.Settings methods that might cause issues -->
      <type regex="true" name=".*\.Properties\.Settings.*" />
      
      <!-- Exclude any methods marked with ObfuscationAttribute(Exclude=true) -->
      <attributelist>
        <type name="System.Reflection.ObfuscationAttribute" />
      </attributelist>
    </exclusionlist>
  </controlflow>

  <!-- String Encryption -->
  <stringencryption>
    <!-- Enable string encryption for better protection -->
    <exclusionlist>
      <!-- Exclude strings that might be used in reflection or configuration -->
      <type regex="true" name=".*\.Properties\..*" />
      <type regex="true" name=".*\.Resources.*" />
      <type regex="true" name=".*\.Settings.*" />
      
      <!-- Exclude connection strings and SQL queries that might need to be readable -->
      <method regex="true" name=".*Connection.*" />
      <method regex="true" name=".*Query.*" />
      <method regex="true" name=".*SQL.*" />
    </exclusionlist>
  </stringencryption>

  <!-- Remove unused code -->
  <removal>
    <!-- Remove unused methods and fields -->
    <option>unreachable</option>
    <option>unusedcode</option>
    
    <exclusionlist>
      <!-- Keep all public members of public types -->
      <type regex="false" name="CounselQuickPlatinum.Form1" />
      
      <!-- Keep event handlers even if they appear unused -->
      <method regex="true" name=".*_Click" />
      <method regex="true" name=".*_Load" />
      <method regex="true" name=".*_Changed" />
      <method regex="true" name=".*_Enter" />
      <method regex="true" name=".*_Leave" />
      <method regex="true" name=".*_KeyPress" />
      <method regex="true" name=".*_KeyDown" />
      <method regex="true" name=".*_KeyUp" />
      <method regex="true" name=".*_MouseClick" />
      <method regex="true" name=".*_Paint" />
      <method regex="true" name=".*_Resize" />
      <method regex="true" name=".*_FormClosing" />
      <method regex="true" name=".*_VisibleChanged" />
      
      <!-- Keep properties that might be accessed via data binding -->
      <property regex="true" name=".*" />
      
      <!-- Keep methods that might be called via reflection -->
      <attributelist>
        <type name="System.Reflection.ObfuscationAttribute" />
      </attributelist>
    </exclusionlist>
  </removal>

  <!-- Application Settings -->
  <application>
    <!-- Specify that this is a Windows Forms application -->
    <option>winforms</option>
  </application>

  <!-- Global options -->
  <global>
    <!-- Optimize for size and performance -->
    <option>mergepdb</option>
    <option>verbose</option>
  </global>

</configuration>